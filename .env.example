# Copy this file to .env and fill in real values.
# .env is never committed.

APP_NAME=homesure
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Safe placeholder only. Never put your real password here.
DATABASE_URL=postgresql://localhost:5432/homesure

# LLM keys (Day 8)
# Real keys must stay in .env, never in Git.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
